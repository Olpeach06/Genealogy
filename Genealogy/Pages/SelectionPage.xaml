<Page x:Class="Genealogy.Pages.SelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Genealogy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SelectionPage">

    <Grid>
        <!-- Заголовок -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Добро пожаловать!" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Выберите тип проекта" 
                       FontSize="16" 
                       Margin="0,10,0,30" 
                       HorizontalAlignment="Center"/>

            <!-- Ряд с карточками -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Карточка "Семейное древо" -->
                <Border x:Name="FamilyCard" 
                        Width="250" Height="350" 
                        Background="#F0F8FF" 
                        CornerRadius="10" 
                        BorderBrush="#3498DB" 
                        BorderThickness="2"
                        Margin="10" 
                        Cursor="Hand"
                        MouseLeftButtonDown="FamilyCard_Click">
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="👨‍👩‍👧‍👦" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Семейное древо" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Для родословной семьи" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Истории, воспоминания, биографии" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Foreground="Gray"/>
                        <Button Content="Выбрать" Background="#3498DB" Foreground="White" Margin="0,20,0,0" Padding="10,5" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Карточка "Племенная книга" -->
                <Border x:Name="BreedingCard" 
                        Width="250" Height="350" 
                        Background="#F0FFF0" 
                        CornerRadius="10" 
                        BorderBrush="#27AE60" 
                        BorderThickness="2"
                        Margin="10" 
                        Cursor="Hand"
                        MouseLeftButtonDown="BreedingCard_Click">
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="🐄" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Племенная книга" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Для селекции животных" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Скрещивания, продуктивность, класс" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Foreground="Gray"/>
                        <Button Content="Выбрать" Background="#27AE60" Foreground="White" Margin="0,20,0,0" Padding="10,5" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Кнопка выхода -->
            <Button Content="Выйти" 
                    Click="LogoutButton_Click"
                    Background="Transparent" 
                    Foreground="#E74C3C" 
                    BorderBrush="#E74C3C" 
                    BorderThickness="1"
                    Margin="0,30,0,0"
                    Padding="15,5"
                    Cursor="Hand"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
